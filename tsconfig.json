{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src", "bench"],
  // Gizli testler koşum takımının parçası değil: yanlarında henüz var olmayan
  // bir üretim artefaktına import atarlar. Yalnızca üretim sonrası, izole
  // dizinde derlenir/koşulurlar (bench/DESIGN.md). vitest.config.ts aynısını yapar.
  "exclude": ["node_modules", "bench/tasks"]
}
